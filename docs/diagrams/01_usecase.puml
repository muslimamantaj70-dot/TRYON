@startuml
title TryOn жүйесі: Use Case диаграммасы

left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #E8F1FB
  BorderColor #2B5C9E
}

' ---- Актор (жүйемен жұмыс істейтін адам немесе сыртқы жүйе)
actor "Клиент" as Client
actor "Сатушы" as Seller
actor "Менеджер" as Manager
actor "Әкімші" as Admin
actor "Төлем жүйесі\n(сыртқы)" as PayGate

' ---- Жүйе шекарасы: ішінде Use Case-тер
rectangle "TryOn жүйесі" {
  usecase "UC-01\nЖүйеге кіру / тіркелу" as UC01
  usecase "UC-02\nДене өлшемдерін енгізу" as UC02
  usecase "UC-03\nТауарды іздеу" as UC03
  usecase "UC-04\nКиімді манекенге киіндіру" as UC04
  usecase "UC-05\nӨлшем ұсыну" as UC05
  usecase "UC-06\nОбраз жинау" as UC06
  usecase "UC-07\nТапсырыс қалыптастыру" as UC07
  usecase "UC-08\nТөлем жасау" as UC08
  usecase "UC-09\nМәртебені бақылау" as UC09
  usecase "UC-10\nҚайтару рәсімдеу" as UC10
  usecase "UC-11\nТапсырыс пен қайтаруды өңдеу" as UC11
  usecase "UC-12\nТауар қосу, өлшем кестесін толтыру" as UC12
  usecase "UC-13\nҚалдық пен бағаны басқару" as UC13
  usecase "UC-14\nПайдаланушылар мен тауарларды басқару" as UC14
  usecase "UC-15\nЕсеп қарау" as UC15
}

' ---- Актор мен Use Case арасындағы байланыс (ассоциация)
Client --> UC01
Seller --> UC01
Manager --> UC01
Admin --> UC01
Client --> UC02
Client --> UC03
Client --> UC04
Client --> UC06
Client --> UC07
Client --> UC09
Client --> UC10
Manager --> UC11
Seller --> UC12
Seller --> UC13
Admin --> UC14
Admin --> UC15
UC08 --> PayGate

' ---- Use Case-тер арасындағы байланыс
UC04 ..> UC05 : <<include>>
UC07 ..> UC08 : <<include>>
UC06 ..> UC04 : <<extend>>
@enduml
