@startuml
title TryOn: Class диаграммасы (дерекқордың 14 кестесіне сәйкес)

' Әр класс = дерекқордағы бір кесте, әр байланыс = бір FOREIGN KEY (барлығы 19).
' Көрінгіштік: - жабық (private), + ашық (public). Атрибут: атауы: Тип, әдіс(параметр: Тип): Қайтару типі
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam roundCorner 8
skinparam packageStyle rectangle
skinparam ArrowColor #333333
skinparam ArrowFontSize 11
skinparam class {
  BackgroundColor White
  BorderColor #333333
  HeaderBackgroundColor #DDE6F2
}
hide empty members

package "Пайдаланушылар" #E8F1FB {
  class Role {
    - id: int
    - code: String
    - name: String
  }
  class User {
    - id: int
    - email: String
    - passwordHash: String
    - fullName: String
    - phone: String
    - shopName: String
    - isActive: boolean
    - createdAt: DateTime
    + register(): void
    + login(email: String, password: String): boolean
    + logout(): void
    + requestReturn(item: OrderItem, qty: int, reason: String): ReturnRequest
  }
  class BodyProfile {
    - sex: char
    - heightCm: int
    - weightKg: decimal
    - chestCm: decimal
    - waistCm: decimal
    - hipCm: decimal
    - isManual: boolean
    + estimateMeasurements(): void
  }
  class Address {
    - city: String
    - street: String
    - house: String
    - apartment: String
    - recipientPhone: String
    - isDefault: boolean
  }
}

package "Каталог және отыру ережелері" #FFF4DC {
  class Category {
    - id: int
    - name: String
    - slug: String
  }
  class GarmentType {
    - code: String
    - name: String
    - slot: String
    + getRules(): FitRule[]
  }
  class FitRule {
    - zone: String
    - tightBelowCm: decimal
    - looseAboveCm: decimal
    + verdict(diffCm: decimal): String
  }
  class Product {
    - id: int
    - name: String
    - description: String
    - price: int
    - colorHex: String
    - pattern: String
    - printKind: String
    - imagePath: String
    - isActive: boolean
    + getSizes(): ProductSize[]
    + recommendSize(p: BodyProfile): ProductSize
    + isAvailable(): boolean
  }
  class ProductSize {
    - sizeLabel: String
    - sku: String
    - chestCm: decimal
    - hemCm: decimal
    - waistCm: decimal
    - hipCm: decimal
    - thighCm: decimal
    - lengthCm: decimal
    - stockQty: int
    + hasStock(qty: int): boolean
  }
}

package "Сатып алу" #E5F4EA {
  class CartItem {
    - qty: int
    + findByUser(u: User): CartItem[]
    + getLineTotal(): int
  }
  class Order {
    - id: int
    - status: OrderStatus
    - totalAmount: int
    - createdAt: DateTime
    + create(customer: User, address: Address): Order
    + changeStatus(s: OrderStatus): void
    + cancel(): void
  }
  class OrderItem {
    - productName: String
    - unitPrice: int
    - qty: int
    + getLineTotal(): int
  }
  class Payment {
    - amount: int
    - method: String
    - status: String
    - paidAt: DateTime
    + pay(): boolean
  }
  class ReturnRequest {
    - qty: int
    - reason: String
    - comment: String
    - status: ReturnStatus
    - refundAmount: int
    - createdAt: DateTime
    + approve(m: User): void
    + reject(m: User): void
    + refund(): void
  }
  enum OrderStatus {
    NEW
    PAID
    PACKED
    SHIPPED
    DELIVERED
    CANCELLED
  }
  enum ReturnStatus {
    REQUESTED
    APPROVED
    REJECTED
    REFUNDED
  }
}

' ----- Композиция (толтырылған ромб): бөлік иесінсіз өмір сүрмейді
' body_profiles.user_id
User "1" *-- "0..1" BodyProfile
' addresses.user_id
User "1" *-- "0..*" Address
' product_sizes.product_id
Product "1" *-- "1..*" ProductSize
' order_items.order_id
Order "1" *-- "1..*" OrderItem

' ----- Ассоциация (еселікпен); түсініктемеде FK бағаны көрсетілген
' users.role_id
Role "1" -- "0..*" User : has role
' categories.parent_id
Category "0..1" -- "0..*" Category : parent
' products.seller_id
User "1" -- "0..*" Product : sells
' products.category_id
Category "1" -- "0..*" Product
' products.garment_type
GarmentType "1" -- "0..*" Product
' fit_rules.garment_type
GarmentType "1" -- "0..*" FitRule
' cart_items.user_id
User "1" -- "0..*" CartItem : cart
' cart_items.product_size_id
ProductSize "1" -- "0..*" CartItem
' orders.customer_id
User "1" -- "0..*" Order : places
' orders.manager_id
User "0..1" -- "0..*" Order : processes
' orders.address_id
Address "1" -- "0..*" Order : ships to
' order_items.product_size_id
ProductSize "1" -- "0..*" OrderItem
' payments.order_id
Order "1" -- "0..*" Payment : paid by
' return_requests.order_item_id
OrderItem "1" -- "0..*" ReturnRequest : returned in
' return_requests.handled_by
User "0..1" -- "0..*" ReturnRequest : handles

' ----- Тәуелділік (үзік көрсеткі)
Product ..> BodyProfile : <<use>>
User ..> Order : <<create>>

@enduml
